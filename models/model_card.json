{
  "model_name": "GradientBoostingRegressor_CarPricePipeline",
  "version": "1.0.0",
  "framework": "scikit-learn 1.3+",
  "training_date": "2024-10-21",
  "pipeline_stages": [
    "FeatureEngineer(reference_year=2024, drop=['Car_Name'])",
    "ColumnTransformer(num=[SimpleImputer, StandardScaler], cat=[SimpleImputer, OneHotEncoder(drop='first')])",
    "GradientBoostingRegressor(n_estimators=100, learning_rate=0.1, max_depth=3, random_state=42)"
  ],
  "input_schema": {
    "Year": "int (e.g. 2003-2024)",
    "Present_Price": "float (in Lakhs INR)",
    "Kms_Driven": "int (kilometers)",
    "Fuel_Type": "str ('Petrol', 'Diesel', 'CNG')",
    "Seller_Type": "str ('Dealer', 'Individual')",
    "Transmission": "str ('Manual', 'Automatic')",
    "Owner": "int (0, 1, 3)"
  },
  "performance": {
    "test_r2": 0.9605,
    "test_mae_lakhs": 0.5892,
    "test_rmse_lakhs": 0.9552
  }
}
